# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/memento
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/memento
MONGO_URI=mongodb://localhost:27017/memento

# Server Port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
